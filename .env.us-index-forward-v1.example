# US_INDEX_FORWARD_V1 -- research/demo forward test only
# Train first:
#   python research/train_us_index_forward_v1.py
# Then inspect research/us_index_forward_v1_result.json before enabling.

US_INDEX_FORWARD_ENABLED=false

# Research was performed on the committed US500 D1 history. Set this to the
# exact broker symbol that represents the same S&P exposure on your demo account.
# Do not map to ES/MES unless contract/tick economics have been verified.
US_INDEX_FORWARD_EXEC_SYMBOL=US500

# Preserve the latest tactical model's 70% maximum allocation cap. For a true
# futures contract, notional can be a misleading exposure measure; leave this
# on until the broker contract specification has been reviewed explicitly.
US_INDEX_FORWARD_APPLY_NOTIONAL_CAP=true

# Existing bridge execution mode. Start READ_ONLY, then APPROVAL, then AUTO on
# DEMO only. The runner hard-blocks AUTO unless MT5 trade_mode == DEMO.
MODE=READ_ONLY

# Existing MT5 credentials/config are read through the normal bridge settings.
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
