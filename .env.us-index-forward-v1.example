# US_INDEX_FORWARD_V1 -- research/demo forward test only
# Train first:
#   python research/train_us_index_forward_v1.py
# Then inspect research/us_index_forward_v1_result.json before enabling.

US_INDEX_FORWARD_ENABLED=false

# The learned model was fit on the committed US500 D1 history. Keep the signal
# feed on the same S&P-style series (or a verified equivalent) so the feature
# distribution remains comparable to training.
US_INDEX_FORWARD_SIGNAL_SYMBOL=US500

# The execution symbol is independent. Leave US500 for the existing broker CFD,
# or map to an ES/MES-style broker symbol only after verifying its tick value,
# tick size, minimum volume, initial margin, session hours, and roll behavior.
US_INDEX_FORWARD_EXEC_SYMBOL=US500

# The runner caps explicit broker initial margin at 70% of equity when the
# symbol reports margin_initial. Raw futures notional is a poor exposure proxy,
# so this fallback notional cap is OFF by default. Enable it only for instruments
# where notional/equity is intentionally the desired constraint.
US_INDEX_FORWARD_APPLY_NOTIONAL_CAP=false

# Existing bridge execution mode. Start READ_ONLY, then APPROVAL, then AUTO on
# DEMO only. The runner hard-blocks AUTO unless MT5 trade_mode == DEMO.
MODE=READ_ONLY

# Existing MT5 credentials/config are read through the normal bridge settings.
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
