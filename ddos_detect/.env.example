# ddos_detect configuration.
#
# Every value below is optional; the defaults shown are what the system uses if
# the variable is absent. They are chosen to be safe rather than convenient.
# Copy to .env and load it into the environment before running, or export the
# variables directly.

# --- dashboard -------------------------------------------------------------
DDOS_BIND_HOST=127.0.0.1
DDOS_BIND_PORT=8787
# Binding a routable address exposes the dashboard. Only enable this behind a
# TLS reverse proxy, and set DDOS_SECURE_COOKIES=true when you do.
DDOS_ALLOW_NON_LOOPBACK_BIND=false
DDOS_SECURE_COOKIES=false

# --- storage ---------------------------------------------------------------
# Holds the SQLite database, the audit log, and the instance secret. Keep the
# directory private (chmod 700) - the secret protects the audit chain.
DDOS_DATA_DIR=./ddos_detect_data
# Metrics and closed alerts older than this are deleted automatically.
DDOS_RETENTION_DAYS=7
# Store a keyed hash of observed source addresses instead of the address itself.
# Top-talker counts still work; the mapping cannot be reversed.
DDOS_ANONYMIZE_SOURCES=false

# --- authorization policy --------------------------------------------------
# Require every target to be covered by a ledger entry. Disabling this is only
# defensible in an isolated lab, and each bypass is written to the audit log.
DDOS_REQUIRE_AUTHORIZATION=true
# Monitoring a public address is far more likely to involve someone else's
# infrastructure. Enable only for public ranges you actually operate.
DDOS_ALLOW_PUBLIC_TARGETS=false
# Maximum lifetime of an authorization entry, forcing periodic re-attestation.
DDOS_AUTHORIZATION_MAX_DAYS=90

# --- capture ---------------------------------------------------------------
# auto | live | offline | none
DDOS_CAPTURE_BACKEND=auto
# Leave empty to use the interface on the route to the target.
DDOS_INTERFACE=
# Bytes captured per packet. Enough for link + IP + TCP headers and nothing
# more; payload beyond this is truncated by the kernel. Values above 256 are
# refused, because this system is header-only by design.
DDOS_SNAPLEN=128
# POSIX only: drop to this user immediately after the capture socket is opened,
# so the long-running capture loop does not run as root.
DDOS_DROP_PRIVILEGES_USER=
DDOS_MAX_MONITORS=8

# --- detection -------------------------------------------------------------
# Detection window. Short, so a burst is measured rather than averaged away.
DDOS_WINDOW_SECONDS=10
DDOS_BUCKET_SECONDS=1
# Alerts are suppressed while the baseline is learned. This assumes traffic is
# normal at startup - restart a monitor if an attack was already in progress.
DDOS_LEARNING_SECONDS=60
DDOS_TOP_TALKERS=10
# Cap on distinct sources tracked per monitor. Bounds memory under a
# spoofed-source flood, which is precisely the case being detected.
DDOS_MAX_TRACKED_SOURCES=20000

# --- authentication and abuse control --------------------------------------
DDOS_SESSION_TTL_SECONDS=3600
DDOS_SESSION_IDLE_TIMEOUT_SECONDS=900
DDOS_MAX_LOGIN_ATTEMPTS=5
DDOS_LOCKOUT_SECONDS=300
DDOS_API_REQUESTS_PER_MINUTE=240
DDOS_LOGIN_REQUESTS_PER_MINUTE=10
# PBKDF2-HMAC-SHA256 iterations. Raise over time as hardware improves; lowering
# it weakens every password already stored.
DDOS_KDF_ITERATIONS=480000
